{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maison-doclar.local/schemas/md.seating.solve.response/1",
  "title": "md.seating.solve.response/1",
  "type": "object",
  "additionalProperties": true,
  "required": ["contractVersion", "modelVersion", "result", "assignments", "tiers", "proofState", "engine", "resources"],
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "md.seating.solve.response/1"
    },
    "modelVersion": {
      "type": "string",
      "enum": ["cpsat-model-v1"]
    },
    "runId": { "type": ["string", "null"] },
    "result": {
      "type": "string",
      "enum": [
        "OPTIMAL",
        "FEASIBLE",
        "INFEASIBLE",
        "SEARCH_INCOMPLETE",
        "TIMED_OUT",
        "INVALID_INPUT",
        "SOLVER_FAULT",
        "CANCELLED"
      ]
    },
    "nativeStatus": { "type": "string" },
    "faultCode": { "type": ["string", "null"] },
    "error": { "type": "string" },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["guest", "table", "seat"],
        "additionalProperties": false,
        "properties": {
          "guest": { "type": "integer", "minimum": 0 },
          "table": { "type": "integer", "minimum": 0 },
          "seat": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "assignmentCount": { "type": "integer", "minimum": 0 },
    "tiers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tier", "proven", "stopReason"],
        "additionalProperties": true,
        "properties": {
          "tier": { "type": "string" },
          "value": { "type": ["integer", "null"] },
          "bound": { "type": ["integer", "null"] },
          "proven": { "type": "boolean" },
          "deterministicSeconds": { "type": "number" },
          "wallSeconds": { "type": "number" },
          "stopReason": { "type": "string" }
        }
      }
    },
    "proofState": {
      "type": "object",
      "required": ["allTiersProven", "tiers"],
      "additionalProperties": true,
      "properties": {
        "allTiersProven": { "type": "boolean" },
        "tiers": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        }
      }
    },
    "deterministicSeconds": { "type": "number" },
    "wallSeconds": { "type": "number" },
    "purpose": { "type": "string" },
    "mode": { "type": "string" },
    "diagnostics": { "type": "object", "additionalProperties": true },
    "engine": {
      "type": "object",
      "required": ["ortools", "python", "model"],
      "additionalProperties": true,
      "properties": {
        "ortools": { "type": "string" },
        "python": { "type": "string" },
        "model": { "type": "string" }
      }
    },
    "resources": {
      "type": "object",
      "required": ["peakRssKb"],
      "additionalProperties": true,
      "properties": {
        "peakRssKb": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
