{
  "name": "@maison-doclar/event-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3020",
    "build": "next build",
    "start": "next start --port ${PORT:-3020}",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "e2e": "playwright test",
    "e2e:eos-s06-current": "playwright test e2e/eos-s06-current-acceptance.spec.ts --workers=1",
    "e2e:ci": "node ./scripts/ci-e2e-run-shards.mjs",
    "e2e:ci:lifecycle": "node ./scripts/ci-e2e-lifecycle-check.mjs",
    "e2e:ci:reset-db": "tsx ./scripts/ci-postgres-reset.ts",
    "seed:cleanup": "tsx ./scripts/synthetic-cleanup.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@maison-doclar/academy": "workspace:*",
    "@maison-doclar/design-system": "workspace:*",
    "@maison-doclar/shared-platform": "workspace:*",
    "next": "^15.2.4",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "typescript": "^5.8.2"
  }
}
