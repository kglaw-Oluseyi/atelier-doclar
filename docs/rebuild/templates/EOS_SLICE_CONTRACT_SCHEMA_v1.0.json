{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maisondoclar.local/eos-slice-contract-schema-v1.0.json",
  "title": "EOS slice contract",
  "type": "object",
  "required": [
    "templateVersion",
    "templateChecksum",
    "categories",
    "capabilities",
    "traceability",
    "technicalDebtDisclosure",
    "certificationStatus"
  ],
  "properties": {
    "templateVersion": { "const": "1.0" },
    "templateChecksum": { "type": "string", "minLength": 64 },
    "categories": {
      "type": "array",
      "items": {
        "enum": [
          "OBJ",
          "ACT",
          "CAP",
          "RULE",
          "DATA",
          "PERM",
          "AUD",
          "UI",
          "API",
          "INT",
          "NFR",
          "BLD",
          "TST",
          "JRN",
          "ACC",
          "DEP",
          "DEC",
          "AMB"
        ]
      },
      "minItems": 18
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "fields",
          "buildUnit",
          "tests",
          "journey",
          "persistence",
          "audit",
          "deployment"
        ],
        "properties": {
          "id": { "type": "string" },
          "fields": { "type": "integer", "minimum": 30 },
          "buildUnit": { "type": "string", "minLength": 1 },
          "tests": { "type": "string", "minLength": 1 },
          "journey": { "type": "string", "minLength": 1 },
          "persistence": { "type": "string", "minLength": 1 },
          "audit": { "type": "string" },
          "deployment": { "type": "string", "minLength": 1 }
        }
      }
    },
    "traceability": { "type": "boolean", "const": true },
    "technicalDebtDisclosure": { "type": "string", "minLength": 1 },
    "certificationStatus": { "type": "string" }
  },
  "additionalProperties": false
}
